# Full pip freeze from this Mac is a local environment snapshot, not a portable lock.
requirements-local-lock.txt

# Only document the data layout in Git; keep source datasets, generated tables,
# enrichment snapshots, embeddings and human/AI-assisted audit labels local.
data/*
!data/README.md

